# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-hex-32
FLASK_DEBUG=False

# Database Configuration
# For PostgreSQL:
DATABASE_URL=postgresql://username:password@localhost:5432/darija_db
# For MySQL:
# DATABASE_URL=mysql://username:password@localhost:3306/darija_db
# For SQLite (development only):
# DATABASE_URL=sqlite:///dashboard.db

# Security
ENCRYPTION_KEY=your-encryption-key-here-generate-with-fernet
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
MAX_CONTENT_LENGTH=16777216

# Admin Configuration (first run only)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@zonemation.com
ADMIN_PASSWORD=change-this-strong-password

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379
RATELIMIT_DEFAULT=100/hour
RATELIMIT_API=1000/hour

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Settings
CORS_ORIGINS=https://yourdomain.com

# Google Cloud Configuration (optional - users can add via UI)
DEFAULT_GOOGLE_API_KEY=

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=